{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "背景",
          "color": "#ffffff"
        },
        {
          "slug": "contrast",
          "name": "正文",
          "color": "#202126"
        },
        {
          "slug": "muted",
          "name": "次要文字",
          "color": "#757782"
        },
        {
          "slug": "accent",
          "name": "点缀色",
          "color": "#4263eb"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "系统字体",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "小",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "正文",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "大",
          "size": "1.5rem"
        },
        {
          "slug": "x-large",
          "name": "标题",
          "size": "2.25rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--xf-bg)",
      "text": "var(--xf-text)"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1rem",
      "lineHeight": "1.8"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--xf-text)"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      }
    }
  }
}
